{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "netlify/functions/**/*.mts",
    "types/node-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
