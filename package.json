{
  "name": "linuxterminal",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-v86-firmware.mjs",
    "build": "tsc && vite build && node scripts/generate-netlify-headers.mjs",
    "preview": "vite preview",
    "test": "npm run test:engine && npm run test:catalog && npm run test:result && npm run test:vnext && npm run test:adversarial && npm run test:session && npm run test:p1 && npm run test:catalog-executable && npm run test:observatory && npm run test:iso && npm run test:iso-worker && npm run test:content-contract && npm run test:telemetry && npm run test:static-security && npm run test:vm-policy && npm run test:tutorials && npm run test:quiz-quality && npm run test:certificate-contract && npm run test:csp-contract && npm run test:sha256 && npm run test:release-security && npm run test:site-routes",
    "test:engine": "node --experimental-strip-types tests/linux-engine.test.ts",
    "test:catalog": "node --experimental-strip-types tests/command-catalog.test.ts",
    "test:catalog-executable": "node --experimental-strip-types tests/catalog-executable.test.ts",
    "test:result": "node --experimental-strip-types tests/command-result.test.ts",
    "test:vnext": "node --experimental-strip-types tests/vnext-correctness.test.ts",
    "test:adversarial": "node --experimental-strip-types tests/adversarial-resource.test.ts",
    "test:session": "node --experimental-strip-types tests/session-manager-concurrency.test.ts",
    "test:p1": "node --experimental-strip-types tests/p1-runtime.test.ts",
    "test:observatory": "node --experimental-strip-types tests/observatory-tutor.test.ts",
    "test:iso": "node --experimental-strip-types tests/iso-integrity.test.ts",
    "test:content-contract": "node tests/content-contract.test.mjs",
    "test:telemetry": "node --experimental-strip-types tests/guest-telemetry.test.ts",
    "test:static-security": "node tests/security-static.test.mjs",
    "test:vm-policy": "node --experimental-strip-types tests/vm-resource-policy.test.ts",
    "test:tutorials": "node tests/learn-tutorials.test.mjs",
    "test:quiz-quality": "node tests/quiz-quality.test.mjs",
    "test:certificate-contract": "node tests/certificate-contract.test.mjs",
    "test:csp-contract": "node tests/csp-report-contract.test.mjs",
    "test:sha256": "node --experimental-strip-types tests/sha256.test.ts",
    "test:release-security": "node tests/release-security-contract.test.mjs",
    "test:site-routes": "node tests/site-routes.test.mjs",
    "test:dist-routes": "node tests/dist-routes.test.mjs",
    "test:real-guest": "node tests/real-guest-alpine.mjs",
    "test:coverage": "node tests/coverage-threshold.mjs",
    "test:security": "npm audit --audit-level=high",
    "test:ci": "npm run test && npm run test:coverage && npm run test:security && npm run build && npm run test:dist-routes && npm run test:artifact-manifest && npm run test:actions-pinning && npm run test:browser-security && npm run test:profile-boot && npm run test:ui-ux",
    "lint": "tsc --noEmit && node tests/security-static.test.mjs",
    "build:iso": "node ./iso-builder/build-iso.mjs",
    "build:all": "npm run build && npm run build:iso",
    "check": "npm run test:ci",
    "test:smoke": "node tests/browser-vm-smoke.mjs",
    "test:mobile": "node tests/mobile-e2e.mjs",
    "test:production": "node tests/production-smoke.mjs",
    "test:artifact-manifest": "node tests/artifact-manifest.test.mjs",
    "test:actions-pinning": "node tests/github-actions-pinning.test.mjs",
    "test:browser-security": "node tests/browser-security-contract.test.mjs",
    "test:all": "npm run test:ci && npm run test:smoke && npm run test:real-guest && npm run test:mobile && npm run test:production",
    "test:iso-worker": "node tests/iso-worker.test.mjs",
    "test:profile-boot": "node tests/profile-boot.mjs",
    "test:ui-ux": "node tests/ui-ux-profile-contract.mjs"
  },
  "dependencies": {
    "monaco-editor": "0.52.2",
    "mongodb": "^6.20.0",
    "@xterm/xterm": "5.5.0",
    "@xterm/addon-fit": "0.11.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "playwright": "1.56.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.8.0"
  }
}
