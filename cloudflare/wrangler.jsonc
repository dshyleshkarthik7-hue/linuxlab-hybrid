{
  "$schema": "https://unpkg.com/wrangler@4.69.0/config-schema.json",
  "name": "linuxterminal-iso",
  "main": "./iso-worker.ts",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": false
  },
  "workers_dev": true,
  "cache": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "ISO_RATE_LIMITER",
      "namespace_id": "20261001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
